# Convex Backend Configuration
# This file documents the environment variables used in this project.
# 
# DO NOT commit .env.local to git - it's automatically created by Convex
# and contains local development configuration.

# The Convex backend deployment URL
# This is automatically set by "convex dev" during development
# Required for the frontend to communicate with the backend
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Your local Convex deployment ID
# Also automatically set by "convex dev"
CONVEX_DEPLOYMENT=anonymous:anonymous-convex-platform

# HTTP Actions URL (if you use Convex HTTP Actions)
# Automatically set by "convex dev"
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
